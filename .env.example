# .env.example - Configurações de Ambiente

# Porta do Servidor (Padrão: 3000)
PORT=3000

# URL do Banco de Dados PostgreSQL (Opcional - Supabase, Neon, Railway ou Vercel Postgres)
# Se não preenchido, o sistema usa o banco local automático em ./data/database.json
DATABASE_URL=postgresql://postgres:senha@db.supabase.co:5432/postgres

# URL Pública (Opcional - Para quando subir na Vercel ou na nuvem)
# Exemplo: https://meu-poker.vercel.app
PUBLIC_URL=
